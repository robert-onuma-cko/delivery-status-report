# Copy to .env for local runs (.env is git-ignored). For the weekly cloud routine,
# set the same variables in the Claude Code environment settings instead.

# Jira (fetch_jira_items.py)
JIRA_EMAIL=you@checkout.com
JIRA_API_TOKEN=

# Email (send_report_email.py) - Gmail / Google Workspace example
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@checkout.com
SMTP_PASSWORD=
SMTP_FROM=you@checkout.com
REPORT_EMAIL_TO=person1@checkout.com,person2@checkout.com
# REPORT_EMAIL_CC=
# SMTP_STARTTLS=true

# Git branch the routine pushes the report files to
# REPORT_GIT_BRANCH=claude/weekly-reports
